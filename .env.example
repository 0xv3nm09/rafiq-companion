# Copy to .env and fill in what you have. Everything runs without any key.
# LLM (optional — without a key Rafiq answers extractively from retrieved policy, still cited)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-5.3-flash
# Or Groq:
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Demo clock: the simulated "today" day-number used by the journey engine
SIM_DAY=5

# Thresholds (see docs workbook for the full tuning table)
MIN_SCORE=0.5
MIN_CONFIDENCE=0.6
ESCALATE_AFTER=2
